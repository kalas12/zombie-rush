# Числа пошагового боя — все здесь. Люди — в resources/humans/*.tres (HP, дальность, урон).
# Подключение: const BC = preload("res://scripts/battle/battle_config.gd")

# ── Ход боя ──────────────────────────────────────────────────────
const TURNS := 12                     # рассвет после этого хода → поражение

# ── Свет ─────────────────────────────────────────────────────────
const LIGHT_OPENING := 1.5            # радиус света из окна / проёма (в клетках)
const LIGHT_FIRE := 3.0               # радиус света костра

# ── Постройки ────────────────────────────────────────────────────
const WINDOW_HP := 40
const FIRE_HP := 12                   # обычный (укус 6) гасит за 2 удара, толстяк (12 × 2) — за 1
const FAT_STRUCT_MULT := 2            # толстяк → укус ×2 по окнам и костру (талант «Таран» — ещё ×2)

# ── Зомби: клеточные значения (каждый зомби — своя фишка) ────────
# move — клеток за ход (диагональ = 1), hp — здоровье, bite — укус.
# HP раненого из армии переводится пропорционально; таланты на скорость/укус/HP
# увеличивают значения в той же пропорции, что и в армии (battle_setup.gd).
const ZOMBIE := {
	"normal": { "move": 2, "hp": 5,  "bite": 6 },
	"runner": { "move": 4, "hp": 3,  "bite": 4 },
	"fat":    { "move": 1, "hp": 12, "bite": 12 },
}
const INFECTED := "normal"            # убитый человек встаёт таким зомби (только до конца боя)
const TEST_ARMY := { "normal": 6, "runner": 3, "fat": 2 }   # бой без армии (F6)

# ── Правила атаки ────────────────────────────────────────────────
const RUSH_PER_ALLY := 1              # НАТИСК: +1 к укусу за каждого своего зомби рядом…
const RUSH_MAX := 3                   # …но не больше +3
const SURROUND_HITS := 2              # ОКРУЖЕНИЕ: ударили столько разных зомби за ход → отступает на 1

# ── Люди ─────────────────────────────────────────────────────────
const PANIC_HP_FRAC := 0.3            # HP ≤ этой доли → паника: не бьёт, бежит к краю
const PANIC_MOVE := 2                 # клеток за ход в панике

# ── Экран ────────────────────────────────────────────────────────
const BAR_HEIGHT := 84.0              # нижняя чёрная полоса (выбор зомби, кнопки); клетка — под окно
const FIELD_FILL := 0.86              # какую долю свободного места занимает поле (1 = впритык)
const NIGHT := Color(0.74, 0.77, 0.94) # CanvasModulate — ночь (темно, но всё читается)
const DARK_CELL_ALPHA := 0.34         # затемнение неосвещённых клеток (правило света)

# Темп анимаций (сек). Ход людей медленнее — чтобы успеть понять, кто что сделал.
const STEP_TIME := 0.11               # шаг зомби на клетку
